{
  "name": "secureauth-demo",
  "version": "1.0.0",
  "description": "Intentionally vulnerable sign-in service for Snyk security demos",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && cp -r src/public dist/public",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "test": "jest --passWithNoTests",
    "lint": "echo 'No linter configured for demo app'"
  },
  "keywords": ["security", "demo", "snyk", "auth"],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "sql.js": "^1.12.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "jsonwebtoken": "^9.0.2",
    "md5": "^2.3.0",
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "@types/sql.js": "^1.4.9",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.18.1",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/md5": "^2.3.5",
    "@types/node": "^22.10.2",
    "@types/uuid": "^10.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": ["**/__tests__/**/*.test.ts"]
  }
}
