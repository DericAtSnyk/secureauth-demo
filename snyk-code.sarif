d in an SQL query. This may result in an SQL Injection vulnerability.","markdown":"Unsanitized input from {0} {1} into {2}, where it is used in an SQL query. This may result in an SQL Injection vulnerability.","arguments": ["[the HTTP request body](0)","[flows](1),(2),(3),(4),(5),(6),(7)","[../db/client.db.prepare](8)"]},"locations": [{  "id": 0,  "physicalLocation": {"artifactLocation": {  "uri": "src/routes/auth.ts",  "uriBaseId": "%SRCROOT%"},"region": {  "startLine":43,  "endLine":43,  "startColumn":19,  "endColumn":26}  }}],"fingerprints": {"identity": "6392f23d-ea50-4651-b05d-868f266bf756","0": "9235d194b64baf3b1ad29a5e665178026fbde6bcfe2a2a0fabae4c9a7c24fb5c","1": "cf7733e4.4773f344.8b18f948.d7919eeb.63e030fe.8020cfdf.0b4f0b50.3d73fe94.f759b1f9.277c621c.a3fa85e7.08906714.5ef953d3.5fce695c.83265159.fd1f3b67","snyk/asset/finding/v1": "6392f23d-ea50-4651-b05d-868f266bf756"},"codeFlows": [{"threadFlows": [{"locations": [{"location": {"id": 0,"physicalLocation": {"artifactLocation": {  "uri": "src/routes/auth.ts",  "uriBaseId": "%SRCROOT%"},"region": {  "startLine":34,  "endLine":34,  "startColumn":35,  "endColumn":39}}}},{"location": {"id": 1,"physicalLocation": {"artifactLocation": {  "uri": "src/routes/auth.ts",  "uriBaseId": "%SRCROOT%"},"region": {  "startLine":34,  "endLine":34,  "startColumn":35,  "endColumn":39}}}},{"location": {"id": 2,"physicalLocation": {"artifactLocation": {  "uri": "src/routes/auth.ts",  "uriBaseId": "%SRCROOT%"},"region": {  "startLine":34,  "endLine":34,  "startColumn":9,  "endColumn":28}}}},{"location": {"id": 3,"physicalLocation": {"artifactLocation": {  "uri": "src/routes/auth.ts",  "uriBaseId": "%SRCROOT%"},"region": {  "startLine":34,  "endLine":34,  "startColumn":11,  "endColumn":16}}}},{"location": {"id": 4,"physicalLocation": {"artifactLocation": {  "uri": "src/routes/auth.ts",  "uriBaseId": "%SRCROOT%"},"region": {  "startLine":42,  "endLine":42,  "startColumn":55,  "endColumn":60}}}},{"location": {"id": 5,"physicalLocation