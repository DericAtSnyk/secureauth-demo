# Copy to .env and fill in values (use secrets manager in production)
NODE_ENV=development
PORT=3000
DATABASE_URL=sqlite://./data/secureauth.db
DB_CONNECTION_STRING=postgresql://user:password@localhost:5432/secureauth
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
JWT_SECRET=
SESSION_SECRET=
STRIPE_SECRET_KEY=
SENDGRID_API_KEY=
